# ==============================================================================
# Syntax Ledger — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values as needed:
#   cp .env.example .env
#
# NOTE: Never commit your actual '.env' file containing real secrets or API keys
# to version control. '.env' is automatically ignored by .gitignore.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
HOST=127.0.0.1
PORT=5000

# Optional API Keys & Integrations (for extensions or external linters)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
